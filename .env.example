# Telegram (required)
BOT_TOKEN=123456:ABC-DEF
ADMIN_IDS=123456,789012

# Database: SQLite by default, PostgreSQL needs `uv sync --extra postgres`
DATABASE_URL=sqlite+aiosqlite:///tgbot/data/database.db
# DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/bot

# FSM storage: empty = in memory, Redis keeps dialogs between restarts (`--extra redis`)
REDIS_URL=

# Logging
PATH_LOGS=tgbot/data/logs.log
LOG_LEVEL=INFO

# Behaviour
BOT_TIMEZONE=Europe/Moscow
BOT_STATUS_NOTIFICATION=true
AUTOBACKUP_HOUR=0
THROTTLE_RATE=0.5
BROADCAST_RATE=25

# Run mode: polling (default) or webhook
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Telegram Mini App: API + frontend + chat menu button (needs a public HTTPS URL)
WEBAPP_ENABLED=false
WEBAPP_URL=
WEBAPP_AUTH_TTL=86400
